{
  "permissions": {
    "allow": [
      "Bash(sort:*)",
      "Bash(cat /home/prop_/projects/property-partner-site/api/.venv/lib/python3.12/site-packages/fastapi/VERSION 2>/dev/null || python3 -c \"import pkg_resources; print\\([pkg for pkg in ['fastapi', 'uvicorn', 'pydantic', 'starlette'] if pkg]\\)\" 2>/dev/null)",
      "Bash(chmod +x:*)",
      "Bash(tail:*)",
      "Bash(cd \"/home/prop_/projects/Listing creator\" && source venv/bin/activate && python -m pytest tests/ -v 2>&1)",
      "Bash(cd \"/home/prop_/projects/Listing creator\" && source venv/bin/activate && python -c \"from main import _validate_env; _validate_env\\(\\)\" 2>&1)",
      "Bash(cd:*)",
      "WebSearch",
      "WebFetch(domain:getlate.dev)",
      "WebFetch(domain:blogambitious.com)",
      "WebFetch(domain:wiringbits.net)",
      "WebFetch(domain:python-sage-meta.readthedocs.io)",
      "WebFetch(domain:developers.make.com)",
      "WebFetch(domain:docs.mixpost.app)",
      "WebFetch(domain:developers.facebook.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:datkira.medium.com)"
    ],
    "deny": [
      "Bash(*openclaw gateway stop*)",
      "Bash(*openclaw gateway restart*)",
      "Bash(*systemctl --user stop openclaw-gateway.service*)",
      "Bash(*systemctl --user restart openclaw-gateway.service*)",
      "Bash(*wa_chat_history.js*--manage-gateway*)",
      "Bash(*rcf-gate-disabled*)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/prop_/.claude/hooks/code-quality-gate.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": []
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/prop_/.claude/hooks/repoforge-commit-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/prop_/.claude/hooks/codex-challenge-commit-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/prop_/.claude/hooks/rcf-intake-gate.sh",
            "timeout": 30,
            "statusMessage": "Checking Repo Context Forge intake gate"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": []
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/prop_/.claude/hooks/skill-discipline-rearm.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/prop_/.claude/hooks/post-edit-blast-radius.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-daltonized"
}
