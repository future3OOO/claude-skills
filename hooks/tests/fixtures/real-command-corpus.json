    {
      "id": "newline-set-commit",
      "commit": true,
      "command": "set -e\ngit commit -m x"
    },
    {
      "id": "group",
      "commit": true,
      "command": "{ git commit -m x; }"
    },
    {
      "id": "if-then",
      "commit": true,
      "command": "if true; then\ngit commit -m x\nfi"
    },
    {
      "id": "for-do",
      "commit": true,
      "command": "for i in 1; do\ngit commit -m x\ndone"
    },
    {
      "id": "and-chain",
      "commit": true,
      "command": "git status && git commit -m x"
    },
    {
      "id": "semicolon",
      "commit": true,
      "command": "git status; git commit -m x"
    },
    {
      "id": "subshell",
      "commit": true,
      "command": "(git commit -m x)"
    },
    {
      "id": "git-C",
      "commit": true,
      "command": "git -C /tmp/repo commit -m x"
    },
    {
      "id": "absolute-git",
      "commit": true,
      "command": "/usr/bin/git commit -m x"
    },
    {
      "id": "command-prefix",
      "commit": true,
      "command": "command git commit -m x"
