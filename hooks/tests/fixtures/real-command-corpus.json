  "commands": [
    {
      "id": "dominant-heredoc-shape",
      "commit": true,
      "command": "cd /home/prop_/projects/claude-skills\ngit add README.md\ngit commit -q -F - <<'MSG'\ndocs: link the dependency repos...\nMSG"
    },
    {
      "id": "newline-add-commit",
      "commit": true,
      "command": "git add -A\ngit commit -m x"
