#!/usr/bin/env python3
"""Run a real RED/GREEN command and keep a bounded workflow summary."""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from hooks.lib.repo_identity import RepoIdentity, RepoIdentityError, resolve_repo_identity  # noqa: E402
from hooks.lib.state_store import read_json, repo_state_dir, utc_timestamp  # noqa: E402
from hooks.lib.workflow_state import WorkflowError, bound_state, commit_tdd, safe_slug  # noqa: E402

MAX_CAPTURE = 16000


def _path(identity: RepoIdentity, slug: str) -> Path:
    return repo_state_dir(identity) / f"tdd-{slug}.json"


def _active_candidate(identity: RepoIdentity, value: str) -> tuple[str, str | None]:
    state = bound_state(identity, safe_slug(value))
    return state["slug"], state.get("workflowId")


def _not_required(identity: RepoIdentity, slug: str, workflow_id: str | None, reason: str) -> int:
    path = _path(identity, slug)
    existing = read_json(path)
    runs = existing.get("runs") if isinstance(existing, dict) else None
    if (
        isinstance(runs, list)
        and existing.get("workflowId") == workflow_id
        and any(isinstance(run, dict) and run.get("valid") is True for run in runs)
    ):
        raise WorkflowError("--not-required cannot replace valid TDD evidence")
    commit_tdd(identity, slug, workflow_id, path, {
        "schemaVersion": 1,
        "slug": slug,
        "workflowId": workflow_id,
        "status": "not-required",
        "reason": reason,
        "updatedAt": utc_timestamp(),
    }, "not-required", expected_evidence=existing)
    print(json.dumps({"summaryPath": str(path), "status": "not-required"}, sort_keys=True))
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cwd", "--repo", dest="cwd", default=os.getcwd())
    parser.add_argument("--slug", required=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--phase", choices=("red", "green"))
    mode.add_argument("--not-required", metavar="REASON")
    parser.add_argument("--behavior")
    parser.add_argument("--seam", default="", help="real public Interface/Seam exercised by the command")
    parser.add_argument("--expected-failure", default="")
    parser.add_argument("--timeout", type=int, default=900)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)

    try:
        identity = resolve_repo_identity(args.cwd)
        slug, workflow_id = _active_candidate(identity, args.slug)
        if args.not_required is not None:
            reason = args.not_required.strip()
            if not reason:
                raise ValueError("--not-required requires a non-empty reason")
            if args.command:
                raise ValueError("--not-required does not accept a command")
            return _not_required(identity, slug, workflow_id, reason)

        behavior = str(args.behavior or "").strip()
        seam = args.seam.strip()
        command = args.command[1:] if args.command and args.command[0] == "--" else args.command
        if not behavior:
            raise ValueError("--behavior is required for RED/GREEN")
        if not seam:
            raise ValueError("--seam is required: name the real production Interface")
        if not command:
            raise ValueError("a command is required after --")

        try:
            result = subprocess.run(
                command,
                cwd=str(identity.root),
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=args.timeout,
                check=False,
            )
            raw, exit_code, timed_out = result.stdout or b"", result.returncode, False
        except subprocess.TimeoutExpired as exc:
            raw = (exc.stdout or b"") + (exc.stderr or b"")
            exit_code, timed_out = 124, True

        path = _path(identity, slug)
        command_text = shlex.join(command)
        expected = args.expected_failure.strip()
        observed = bool(expected) and expected in raw.decode("utf-8", errors="replace")
        existing = read_json(path)
        same_instance = bool(existing) and existing.get("workflowId") == workflow_id
        matches = same_instance and all(existing.get(key) == value for key, value in {
            "slug": slug,
            "behavior": behavior,
            "seam": seam,
            "command": command_text,
        }.items())
        completed_cycle = same_instance and existing.get("status") == "passed"
        prior_runs = existing.get("runs") if matches and isinstance(existing.get("runs"), list) else []
        prior_red = any(isinstance(run, dict) and run.get("phase") == "red" and run.get("valid") is True for run in prior_runs)
        valid = (
            not timed_out and exit_code != 0 and observed
            if args.phase == "red"
            else not timed_out and exit_code == 0 and prior_red
        )
        preserved = args.phase == "red" and matches and not valid and completed_cycle
        new_cycle = args.phase == "red" and valid and not matches and (not same_instance or completed_cycle)
        recorded = not preserved and (matches or new_cycle)
        regression = args.phase == "green" and matches and not valid
        if args.phase == "red" and valid and not matches and same_instance and not completed_cycle:
            print(
                "error: candidate does not match the active cycle; finish or regress the current candidate first",
                file=sys.stderr,
            )
            return 2
        run = {
            "phase": args.phase,
            "expectedFailure": expected or None,
            "exitCode": exit_code,
            "timedOut": timed_out,
            "outputTail": raw[-MAX_CAPTURE:].decode("utf-8", errors="replace"),
            "valid": valid,
        }
        if recorded:
            reopen = regression or (args.phase == "red" and valid and (new_cycle or completed_cycle))
            action = (
                "passed" if args.phase == "green" and valid
                else "reopen" if reopen
                else "in-progress"
            )
            commit_tdd(identity, slug, workflow_id, path, {
                "schemaVersion": 1,
                "slug": slug,
                "workflowId": workflow_id,
                "status": "passed" if args.phase == "green" and valid else "pending",
                "behavior": behavior,
                "seam": seam,
                "command": command_text,
                "runs": [*prior_runs, run] if matches else [run],
                "updatedAt": utc_timestamp(),
            }, action, expected_evidence=existing)

        output = raw[-MAX_CAPTURE:].decode("utf-8", errors="replace")
        if output:
            print(output, end="" if output.endswith("\n") else "\n")
        print(json.dumps({"summaryPath": str(path), "phase": args.phase, "valid": valid, "exitCode": exit_code}, sort_keys=True))
        if not valid:
            message = "RED must fail for the expected reason." if args.phase == "red" else "GREEN must pass after a valid RED for the same command, behavior, and Seam."
            print(message, file=sys.stderr)
            return 2
        return 0
    except (RepoIdentityError, WorkflowError, ValueError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
